{
  "name": "llm-incident-reporting",
  "version": "1.0.0",
  "description": "LLM-Driven Incident Reporting System with Node.js/TypeScript and GCP",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "test": "jest",
    "deploy:ingest": "gcloud functions deploy logIngestion --runtime nodejs18 --trigger-http --allow-unauthenticated",
    "deploy:process": "gcloud functions deploy logProcessing --runtime nodejs18 --trigger-topic raw-app-logs",
    "deploy:analyze": "gcloud functions deploy llmAnalysis --runtime nodejs18 --trigger-topic clean-app-logs",
    "deploy:report": "gcloud functions deploy incidentReporting --runtime nodejs18 --trigger-http",
    "deploy:alert": "gcloud functions deploy incidentAlerting --runtime nodejs18 --trigger-http"
  },
  "keywords": [
    "gcp",
    "nodejs",
    "typescript",
    "llm",
    "incident-reporting"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/bigquery": "^7.3.0",
    "@google-cloud/functions-framework": "^3.3.0",
    "@google-cloud/pubsub": "^3.6.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "axios": "^1.6.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.3.1",
    "googleapis": "^126.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}

